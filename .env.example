# --- Database ---
DATABASE_URL=postgres://openlane:openlane@localhost:5432/openlane?sslmode=disable

# --- Redis (rate limit + cache; optional in P0) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (VaultS3, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openlane
S3_SECRET_KEY=openlane-secret
S3_BUCKET=openlane-files

# --- Auth ---
JWT_SECRET=change-me-32-bytes-minimum-random
MAGIC_LINK_SECRET=change-me-too
APP_URL=http://localhost:3000

